      <owl:someValuesFrom rdf:resource="#MICRONT_09020402"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">traditional agriculturalist</rdfs:label>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Non-industrialized lifestyle where food is primarily obtained from traditional agriculture, i.e. procuded in small lots without relying on industrial machines and technology; this includes pastoralism.</obo:IAO_0000115>
</owl:Class>

<owl:Class rdf:about="#MICRONT_09090100">
