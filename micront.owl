<owl:Class rdf:about="#MICRONT_09020401">
  <rdfs:subClassOf rdf:resource="#MICRONT_09020400"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">industrialized</rdfs:label>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lifestyle dominated by products and services provided by the use of (industrial) machines and technology</obo:IAO_0000115>
</owl:Class>

<owl:Class rdf:about="#MICRONT_09020402">
  <rdfs:subClassOf rdf:resource="#MICRONT_09020400"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">non-industrialized</rdfs:label>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lifestyle not majorly impacted by products and services resulting from the use of industrial machines and technology; this includes in particular food production and processing, domestic living conditions (including sanitation) and transport</obo:IAO_0000115>
</owl:Class>

<owl:Class rdf:about="#MICRONT_09020403">
  <rdfs:subClassOf rdf:resource="#MICRONT_09020400"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#crosslinked_to"/>
      <owl:someValuesFrom rdf:resource="#MICRONT_09020402"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hunter-gatherer</rdfs:label>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Non-industrialized lifestyle where food is primarily obtained by foraging, i.e. not relying on agriculture or animal husbandry</obo:IAO_0000115>
</owl:Class>

<owl:Class rdf:about="#MICRONT_09020404">
  <rdfs:subClassOf rdf:resource="#MICRONT_09020400"/>
  <rdfs:subClassOf>
    <owl:Restriction>
